# tash - Terminal Assistant Shell
# Auto-generated by tash init

# Short aliases
function t --wraps=tash --description 'tash shortcut'
    /home/raidr/.local/bin/tash $argv
end
function q --wraps='tash query' --description 'tash query shortcut'
    set -l result (/home/raidr/.local/bin/tash query --session $fish_pid "$argv")
    if test -n "$result"
        commandline -r "$result"
    end
end

##function fish_greeting
##    /home/raidr/.local/bin/tash greet
##end

function fish_command_not_found
    set -g __tash_handled 1
    set -l result (/home/raidr/.local/bin/tash query --session $fish_pid "$argv")
    if test -n "$result"
        commandline -r "$result"
    end
end

function tash_tick --on-event fish_postexec
    set -l last_status $status
    # Only unknown commands go through to tash
    if set -q __tash_handled
        set -e __tash_handled
        /home/raidr/.local/bin/tash tick --exit-code $last_status --session $fish_pid --command "$argv" &
        return
    end
end
