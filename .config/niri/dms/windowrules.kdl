// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=dms_rule_0 @name=
window-rule {
    match title="Keybinds"
    open-floating true
}

// @id=dms_rule_7 @name=
window-rule {
    match app-id="^floorp$"
    background-effect {
        blur true
        xray true
    }
}

// @id=dms_rule_8 @name=
window-rule {
    match app-id="^Alacritty$"
    background-effect {
        blur true
        xray true
    }
}

// @id=dms_rule_9 @name=
window-rule {
    match app-id="Oklch Color Picker"
    open-floating true
    default-column-width { fixed 600; }
    default-window-height { fixed 360; }
}

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^com.danklinux.dms$"
    open-floating true
}

// @id=dms_rule_5 @name=
window-rule {
    match app-id="^dropterm.st$"
    open-floating true
    background-effect {
        blur false
        xray false
    }
}

// @id=dms_rule_6 @name=
window-rule {
    match app-id="^dropterm.nvim$"
    open-floating true
}

// @id=dms_rule_7 @name=
window-rule {
    match app-id="^droptop$"
    open-floating true
    border { active-color "#1f142f"; }
    focus-ring { off; }
}

// @id=dms_rule_8 @name=
window-rule {
    border { active-color "#003353"; }
}
